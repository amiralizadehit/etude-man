# Postgres. Locally both URLs are the same; on Vercel DATABASE_URL is the pooled
# connection and DIRECT_DATABASE_URL the direct one (used by migrations).
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/etude_man"
DIRECT_DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/etude_man"

# Better Auth. Locally the app is served through Vite on :5173.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"

# Flat.io personal access token (OMR scope)
FLAT_TOKEN=""

# Anthropic API key
ANTHROPIC_API_KEY=""

# Separate database for end-to-end tests (Playwright); never the dev database.
TEST_DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/etude_man_test"

# Password for the seeded reviewer accounts (prisma/seedAccounts.ts).
SEED_PASSWORD=""
