{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/server", "src/shared", "api", "e2e", "prisma", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "prisma.config.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
