{
  "framework": "vite",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "bunVersion": "1.x",
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
