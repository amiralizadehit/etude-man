{
  "framework": "vite",
  "buildCommand": "bunx prisma migrate deploy && bun run build",
  "outputDirectory": "dist",
  "bunVersion": "1.x",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{@better-auth,@better-fetch,better-call}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
